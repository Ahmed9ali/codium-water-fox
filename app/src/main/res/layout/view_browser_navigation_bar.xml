<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/preferredNavigationBarColor">

    <View
        android:id="@+id/shadowView"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="?attr/daxColorShadeSolid"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/barView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/navigationBarPaddingHorizontal"
        android:paddingTop="@dimen/navigationBarPaddingTop"
        android:paddingBottom="@dimen/navigationBarPaddingBottom"
        app:layout_constraintTop_toBottomOf="@id/shadowView">

        <!-- Left Side: Bookmarks -->
        <FrameLayout
            android:id="@+id/bookmarksButton"
            android:layout_width="@dimen/toolbarIcon"
            android:layout_height="@dimen/toolbarIcon"
            android:layout_marginEnd="32dp"
            android:background="@drawable/selectable_item_rounded_corner_background">

            <ImageView
                android:id="@+id/bookmarksImageView"
                android:layout_width="@dimen/bottomNavIcon"
                android:layout_height="@dimen/bottomNavIcon"
                android:layout_gravity="center"
                android:src="@drawable/ic_bookmarks_24" />
        </FrameLayout>

        <!-- CENTER: Fire Button (Restored for the Browser) -->
        <!-- The Tab Switcher will change this to the + icon automatically via Kotlin -->
        <FrameLayout
            android:id="@+id/fireButton"
            android:layout_width="@dimen/toolbarIcon"
            android:layout_height="@dimen/toolbarIcon"
            android:layout_weight="1"
            android:background="@drawable/selectable_item_rounded_corner_background">

            <ImageView
                android:id="@+id/fireButtonImageView"
                android:layout_width="@dimen/bottomNavIcon"
                android:layout_height="@dimen/bottomNavIcon"
                android:layout_gravity="center"
                android:src="@drawable/ic_fire_24" />
        </FrameLayout>

        <!-- Mid-Right: Tab Switcher -->
        <com.duckduckgo.browser.ui.tabs.NewTabSwitcherButton
            android:id="@+id/tabsButton"
            android:layout_width="@dimen/toolbarIcon"
            android:layout_height="@dimen/toolbarIcon"
            android:layout_marginStart="32dp" />

        <!-- Right Side: Menu -->
        <FrameLayout
            android:id="@+id/menuButton"
            android:layout_width="@dimen/toolbarIcon"
            android:layout_height="@dimen/toolbarIcon"
            android:background="@drawable/selectable_item_rounded_corner_background">

            <ImageView
                android:id="@+id/browserMenuImageView"
                android:layout_width="@dimen/bottomNavIcon"
                android:layout_height="@dimen/bottomNavIcon"
                android:layout_gravity="center"
                android:src="@drawable/ic_menu_vertical_24" />

            <View
                android:id="@+id/browserMenuHighlight"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="end"
                android:layout_margin="@dimen/keyline_2"
                android:background="@drawable/ic_dot_indicator_7"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
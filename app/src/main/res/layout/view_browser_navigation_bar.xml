<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/preferredNavigationBarColor">

    <View
        android:id="@+id/shadowView"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="?attr/daxColorShadeSolid"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Left: Fire Button -->
    <FrameLayout
        android:id="@+id/fireButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/fireButtonImageView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_fire_24" />
    </FrameLayout>

    <!-- Center: Tabs Button -->
    <com.duckduckgo.browser.ui.tabs.NewTabSwitcherButton
        android:id="@+id/tabsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Right: Menu Button -->
    <FrameLayout
        android:id="@+id/menuButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/browserMenuImageView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_menu_vertical_24" />
        <View
            android:id="@+id/browserMenuHighlight"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_gravity="end"
            android:layout_margin="@dimen/keyline_2"
            android:background="@drawable/ic_dot_indicator_7"
            android:visibility="gone" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
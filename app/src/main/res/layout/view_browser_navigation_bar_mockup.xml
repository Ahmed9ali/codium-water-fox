<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!--
      Brave-style bar: five EQUAL-WIDTH cells, each icon centered in its cell.

      Browser / New tab / Duck.ai:  Home | Bookmark | Search | Tabs | More
      Tab manager (tab switcher):   Fire |     -    |  + FAB | -    | More

      Cells 1 and 3 hold two overlapping buttons; the view model decides which one is visible.
    -->
    <LinearLayout
        android:id="@+id/barView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/preferredNavigationBarColor"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/navigationBarPaddingHorizontal"
        android:paddingTop="@dimen/navigationBarPaddingTop"
        android:paddingBottom="@dimen/navigationBarPaddingBottom"
        app:layout_constraintTop_toTopOf="parent"
        tools:parentTag="androidx.coordinatorlayout.widget.CoordinatorLayout">

        <!-- Cell 1: Home (browser modes) / Fire (tab manager, or onboarding highlight) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/homeButton"
                android:layout_width="@dimen/toolbarIcon"
                android:layout_height="@dimen/toolbarIcon"
                android:layout_gravity="center"
                android:background="@drawable/selectable_item_rounded_corner_background">

                <ImageView
                    android:id="@+id/homeImageView"
                    android:layout_width="@dimen/bottomNavIcon"
                    android:layout_height="@dimen/bottomNavIcon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/navBarHome"
                    android:scaleType="center"
                    android:src="@drawable/ic_nav_home_24" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fireButton"
                android:layout_width="@dimen/toolbarIcon"
                android:layout_height="@dimen/toolbarIcon"
                android:layout_gravity="center"
                android:background="@drawable/selectable_item_rounded_corner_background"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/fireIconImageView"
                    android:layout_width="@dimen/bottomNavIcon"
                    android:layout_height="@dimen/bottomNavIcon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/fireMenu"
                    android:scaleType="center"
                    android:src="@drawable/ic_fire_24" />
            </FrameLayout>
        </FrameLayout>

        <!-- Cell 2: Bookmark -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/bookmarksButton"
                android:layout_width="@dimen/toolbarIcon"
                android:layout_height="@dimen/toolbarIcon"
                android:layout_gravity="center"
                android:background="@drawable/selectable_item_rounded_corner_background">

                <ImageView
                    android:id="@+id/bookmarksImageView"
                    android:layout_width="@dimen/bottomNavIcon"
                    android:layout_height="@dimen/bottomNavIcon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/bookmarksMenuTitle"
                    android:scaleType="center"
                    android:src="@drawable/ic_nav_bookmark_24" />
            </FrameLayout>
        </FrameLayout>

        <!-- Cell 3: Search (browser modes) / centered + FAB (tab manager only) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/searchButton"
                android:layout_width="@dimen/toolbarIcon"
                android:layout_height="@dimen/toolbarIcon"
                android:layout_gravity="center"
                android:background="@drawable/selectable_item_rounded_corner_background">

                <ImageView
                    android:id="@+id/searchImageView"
                    android:layout_width="@dimen/bottomNavIcon"
                    android:layout_height="@dimen/bottomNavIcon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/navBarSearch"
                    android:scaleType="center"
                    android:src="@drawable/ic_nav_search_24" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/newTabButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:id="@+id/newTabButtonImageView"
                    android:layout_width="@dimen/bottomNavIcon"
                    android:layout_height="@dimen/bottomNavIcon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/newTabMenuItem"
                    android:scaleType="center"
                    android:src="@drawable/ic_add_24" />
            </FrameLayout>
        </FrameLayout>

        <!-- Cell 4: Tabs (with count) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <com.duckduckgo.browser.ui.tabs.NewTabSwitcherButton
                android:id="@+id/tabsButton"
                android:layout_width="@dimen/toolbarIcon"
                android:layout_height="@dimen/toolbarIcon"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- Cell 5: More -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/menuButton"
                android:layout_width="@dimen/toolbarIcon"
                android:layout_height="@dimen/toolbarIcon"
                android:layout_gravity="center"
                android:background="@drawable/selectable_item_rounded_corner_background">

                <ImageView
                    android:id="@+id/browserMenuImageView"
                    android:layout_width="@dimen/bottomNavIcon"
                    android:layout_height="@dimen/bottomNavIcon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/browserPopupMenu"
                    android:scaleType="center"
                    android:src="@drawable/ic_menu_vertical_24" />

                <View
                    android:id="@+id/browserMenuHighlight"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="end"
                    android:layout_margin="@dimen/keyline_2"
                    android:background="@drawable/ic_dot_indicator_7"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>

    </LinearLayout>

    <View
        android:id="@+id/shadowView"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="?attr/daxColorShadeSolid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>